# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Free Alpaca keys: https://alpaca.markets  (use the PAPER/data keys)
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here

# Free Tiingo token (cleaner historical EOD): https://www.tiingo.com/account/api/token
TIINGO_API_KEY=your_token_here
